generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String

  name String
  bio  String? @db.VarChar(250)

  avatar String?
  banner String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Privacy
  isPrivate Boolean @default(false)

  reviewsVisibility   Visibility @default(FOLLOWERS)
  watchlistVisibility Visibility @default(FOLLOWERS)
  favoritesVisibility Visibility @default(FOLLOWERS)
  activityVisibility  Visibility @default(FOLLOWERS)

  allowMessages MessagePrivacy @default(FOLLOWERS)

  // Relations
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  receivedFollowRequests FollowRequest[] @relation("ReceivedFollowRequests")
  sentFollowRequests     FollowRequest[] @relation("SentFollowRequests")

  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")

  reviews   Review[]
  replies   Reply[]
  watchlist Watchlist[]

  favoriteMovies FavoriteMovie[]

  twoFactorEnabled Boolean @default(false)
twoFactorSecret  String?

emailVerified   Boolean   @default(false)
emailVerifiedAt DateTime?
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model FollowRequest {
  id         Int                 @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FollowRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  sender   User @relation("SentFollowRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFollowRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Watchlist {
  id     Int @id @default(autoincrement())
  userId Int

  tmdbId      Int
  title       String
  poster      String?
  backdrop    String?
  overview    String?
  releaseDate String?

  status String @default("PLANNED")
  rating Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model FavoriteMovie {
  id Int @id @default(autoincrement())

  userId Int

  tmdbId      Int
  title       String
  poster      String?
  backdrop    String?
  overview    String?
  releaseDate String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model Review {
  id Int @id @default(autoincrement())

  userId Int

  tmdbId Int

  rating Float
  review String

  spoiler Boolean @default(false)

  title       String?
  poster      String?
  backdrop    String?
  overview    String?
  releaseDate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  replies       Reply[]
  notifications Notification[]

  @@unique([userId, tmdbId])
}

model Reply {
  id Int @id @default(autoincrement())

  reviewId Int
  userId   Int

  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id Int @id @default(autoincrement())

  type NotificationType

  senderId   Int
  receiverId Int

  reviewId Int?

  message String? @db.VarChar(255)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  sender   User    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead])
  @@index([createdAt])
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum MessagePrivacy {
  EVERYONE
  FOLLOWERS
  FOLLOWING
  MUTUALS
  NOBODY
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  FOLLOW_REQUEST
  FOLLOW
  LIKE
  REPLY
}
